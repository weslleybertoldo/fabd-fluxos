{
  "name": "@fabd-fluxos/desktop",
  "version": "1.3.0",
  "private": true,
  "author": "Weslley Bertoldo <weslleybertoldo18@gmail.com>",
  "description": "FABD Fluxos — wrapper Electron (Windows)",
  "main": "main.js",
  "scripts": {
    "dev": "cross-env FABD_DEV=1 electron .",
    "start": "electron .",
    "build": "electron-builder --win --x64 --publish never",
    "build:publish": "electron-builder --win --x64 --publish always"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "br.com.fabd.fluxos",
    "productName": "FABD Fluxos",
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "weslleybertoldo",
      "repo": "fabd-fluxos"
    }
  }
}
