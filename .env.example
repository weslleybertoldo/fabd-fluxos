# ============================================================================
# FABD Fluxos — env vars
# Copiar para .env.local em apps/web (NUNCA commitar valores reais)
# ============================================================================

# --- Supabase (publicas, vao pro browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_<...>

# --- Supabase (server-only, NUNCA expor no browser, NUNCA commitar valor real) ---
# Pegar em: https://supabase.com/dashboard/project/<ref>/settings/api-keys (Secret keys)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_<...>

# --- App ---
NEXT_PUBLIC_APP_URL=https://fluxos.fabd.com.br

# --- Resend (email — usado em notificacoes Fase 8) ---
# RESEND_API_KEY=re_xxx
